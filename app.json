{
  "expo": {
    "name": "Chargissimo Admin",
    "slug": "ChargissimoAdminApp",
    "scheme": "chargissimoadmin",
    "owner": "phildevsecur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#4479bf",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chargissimo.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "fr"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4479bf"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.chargissimo.admin"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4479bf"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e7ce8c2-bb1b-4a81-b295-160537e5ed2e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5e7ce8c2-bb1b-4a81-b295-160537e5ed2e"
    }
  }
}
